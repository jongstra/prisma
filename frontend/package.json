{
  "name": "dettect-visualizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve-backend": "cd ../backend && source venv/bin/activate && python3 app.py",
    "serve": "vite",
    "dev": "npm run serve",
    "dev-old": "concurrently \"npm:serve\" \"npm:serve-backend\"",
    "build": "run-p build-vue build-backend",
    "preview": "vite preview",
    "test-unit": "vitest",
    "type-check": "vue-tsc --build --force",
    "build-vue": "vite build",
    "build-backend": "cd ../backend && source venv/bin/activate && python3 setup.py sdist bdist_wheel"
  },
  "dependencies": {
    "@vueform/slider": "^2.1.10",
    "axios": "^1.7.2",
    "concurrently": "^8.2.2",
    "js-yaml": "^4.1.0",
    "pinia": "^2.1.7",
    "sweetalert2": "^11.16.1",
    "uuid": "^11.0.3",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.12.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^6.1.2",
    "typescript": "~5.4.0",
    "vite": "^5.2.8",
    "vite-plugin-vue-devtools": "^7.0.25",
    "vitest": "^1.4.0",
    "vue-tsc": "^2.0.11"
  },
  "overrides": {
    "chalk": "5.3.0",
    "strip-ansi": "7.1.0",
    "color-convert": "2.0.1",
    "color-name": "1.1.4",
    "ansi-styles": "6.2.1",
    "debug": "4.4.1",
    "wrap-ansi": "9.0.0",
    "ansi-regex": "6.2.0",
    "supports-color": "10.2.0",
    "is-core-module": "2.13.1",
    "error-ex": "1.3.2",
    "has-ansi": "5.0.1"
  }
}
